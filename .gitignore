# gstack (github.com/garrytan/gstack) — local, project-scoped install.
# The vendored source, generated skill symlinks, and runtime state are
# regenerated by scripts/setup-gstack.sh; they don't belong in history
# (third-party repo + node_modules + compiled binaries).
/.gstack-src/
/.pw-browsers-local/
/.claude/skills/
/.gstack/

